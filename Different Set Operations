A = {1, 2, 3, 4}
B = {3, 4, 5, 6}

print("Set A:", A)
print("Set B:", B)

print("Union:", A | B)
print("Intersection:", A & B)
print("Difference:", A - B)
print("Symmetric Difference:", A ^ B)

print("Membership:", 2 in A)

A.add(7)
print("After adding:", A)

A.remove(1)
print("After removing:", A)
